# Copy to .env and fill in. Do not commit .env.
# The project still runs without a key (rules + grounded templates).
# Set a key if you want Gemini to polish drafts.

GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-2.0-flash
LLM_PROVIDER=gemini

# Optional. 1 = treat every gated send as approved this run.
# Refusals (injection / phishing / wires) still never go out.
INBOXHERO_AUTO_APPROVE=0
